#!/bin/bash
# Reloads the claude-sync launchd agent when the plist changes.
# Hash: {{ include "private_Library/LaunchAgents/com.chris.claude-sync.plist.tmpl" | sha256sum }}
{{ if not .is_workspace }}
PLIST="$HOME/Library/LaunchAgents/com.chris.claude-sync.plist"
GUI_DOMAIN="gui/$(id -u)"

launchctl bootout "${GUI_DOMAIN}/com.chris.claude-sync" 2>/dev/null || true
launchctl bootstrap "${GUI_DOMAIN}" "$PLIST"
{{ end }}
