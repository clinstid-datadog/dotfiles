    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "sonnet[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message' | xargs -I {} terminal-notifier -message \"{}\" -title \"Claude Code Alert\" -group \"$(pwd):notification\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message \"Claude has completed its task in $(basename $(pwd))\" -title \"Claude Code Finished\" -group \"$(pwd):completion\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); echo \"$(echo \"$input\" | jq -r '.model.display_name')\""
  },
  "enabledPlugins": {
    "dd@datadog-claude-plugins": true,
    "marketplace-auto-update@datadog-claude-plugins": true,
    "skills@datadog-claude-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "feature@datadog-claude-plugins": true,
    "mermaid@datadog-claude-plugins": true,
    "slack@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "theme": "auto",
  "editorMode": "vim",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
