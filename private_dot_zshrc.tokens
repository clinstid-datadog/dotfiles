# GitLab
export GITLAB_TOKEN=$(get-secret gitlab-token)

# github
export github_personal_token=$(get-secret github-personal-token)
export GITHUB_ACCESS_TOKEN=${github_personal_token}
export ATLASSIAN_API_TOKEN=$(get-secret atlassian-api-key)
export CONFLUENCE_API_TOKEN=$(get-secret atlassian-api-key)
export CME_AUTH__CONFLUENCE__API__TOKEN=$(get-secret atlassian-api-key)
