# Non-dotfile repo files — never managed by chezmoi
CLAUDE.md
scripts/**
install.sh

# macOS-only files — skip on workspaces
{{ if .is_workspace }}
.zshrc.macos
Library/**
{{ end }}

# Linux-only files — skip on macOS
{{ if not .is_workspace }}
.zshrc.linux
.config/procps
.config/systemd
{{ end }}

# Workspace-only files — skip on macOS
{{ if not .is_workspace }}
.ssh/config
.ssh/github.pub
main.code-workspace
.config/nvim/lsp/**
{{ end }}

# Project memory dirs are macOS-specific path-encoded dirs; skip on workspaces
{{ if .is_workspace }}
.claude/projects/**
{{ end }}

# nvim lazy plugin lock file — machine-local, not synced
.config/nvim/lazy-lock.json

# ~/.claude ephemeral and machine-local files
.claude/.watchman-cookie-*
.claude/.last-cleanup
.claude/.update.lock
.claude/history.jsonl
.claude/sessions/**
.claude/session-env/**
.claude/file-history/**
.claude/cache/**
.claude/paste-cache/**
.claude/shell-snapshots/**
.claude/backups/**
.claude/telemetry/**
.claude/todos/**
.claude/plugins/**
.claude/downloads/**
.claude/debug/**
.claude/ide/**
.claude/plans/**
.claude/policy-limits.json
.claude/stats-cache.json
.claude/statsig/**
.claude/mcp-needs-auth-cache.json
